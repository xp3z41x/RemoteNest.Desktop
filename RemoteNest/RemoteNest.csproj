<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>RemoteNest</AssemblyName>
    <AssemblyTitle>RemoteNest</AssemblyTitle>
    <RootNamespace>RemoteNest</RootNamespace>
    <Description>RDP Connection Manager for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Overrides the transitive bundle (2.1.11): CVE-2025-6965 is only fixed in
         SQLite >= 3.50.2, which ships from SQLitePCLRaw 3.x onwards. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow test project to access internal helpers (ParseFullAddress, RdpFileBuilder). -->
    <InternalsVisibleTo Include="RemoteNest.Tests" />
  </ItemGroup>

</Project>
