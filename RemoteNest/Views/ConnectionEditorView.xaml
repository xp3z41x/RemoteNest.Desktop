<Window x:Class="RemoteNest.Views.ConnectionEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:converters="clr-namespace:RemoteNest.Converters"
        xmlns:loc="clr-namespace:RemoteNest.Localization"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="/Assets/app.ico"
        Title="{loc:Str EditorTitle}"
        Width="760" Height="840"
        MinWidth="760" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:StringNotEmptyToBoolConverter x:Key="NotEmpty" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Nine tabs sized so no tab ever needs vertical scrolling at the default window
             size. The ScrollViewers stay as a safety net for tiny displays only. -->
        <TabControl Grid.Row="0">
            <!-- General Tab -->
            <TabItem Header="{loc:Str General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str NameRequired}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str NameRequired}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str NamePlaceholder}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" FontSize="11"
                                   Margin="0,-8,0,8"
                                   Visibility="{Binding NameError, Converter={StaticResource NotNullToVis}}" />

                        <TextBlock Text="{loc:Str GroupLabel}" Margin="0,0,0,4" />
                        <ComboBox IsEditable="True" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AvailableGroups}"
                                  AutomationProperties.Name="{loc:Str GroupLabel}"
                                  ui:ControlHelper.PlaceholderText="{loc:Str GroupPlaceholder}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str HostRequired}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str HostRequired}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str HostPlaceholder}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding HostError}" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" FontSize="11"
                                   Margin="0,-8,0,8"
                                   Visibility="{Binding HostError, Converter={StaticResource NotNullToVis}}" />

                        <TextBlock Text="{loc:Str Port}" Margin="0,0,0,4" />
                        <ui:NumberBox x:Name="PortBox" Minimum="1" Maximum="65535"
                                      AutomationProperties.Name="{loc:Str Port}"
                                      Value="{Binding Port, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Compact" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str Notes}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str Notes}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str AutoConnect}"
                                         IsOn="{Binding AutoConnectOnStartup, Mode=TwoWay}" Margin="0,0,0,12" />

                        <Separator Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Str CopySettingsFrom}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding CopySourceProfiles}"
                                      SelectedItem="{Binding SelectedCopySource}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="{loc:Str CopySettingsFrom}"
                                      HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="{loc:Str CopyButton}"
                                    Command="{Binding CopyFromProfileCommand}" />
                        </Grid>
                        <TextBlock Text="{loc:Str CopySettingsHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Credentials & Security Tab -->
            <TabItem Header="{loc:Str CredentialsTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str Username}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str Username}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str Password}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordField" Margin="0,0,0,12"
                                     AutomationProperties.Name="{loc:Str Password}"
                                     PasswordChanged="PasswordField_Changed" />

                        <TextBlock Text="{loc:Str Domain}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str Domain}"
                                 Margin="0,0,0,12" />

                        <Separator Margin="0,4,0,12" />
                        <TextBlock Text="{loc:Str SecuritySection}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <TextBlock Text="{loc:Str AuthLevelLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AuthLevelOptions}"
                                  SelectedIndex="{Binding AuthenticationLevel}"
                                  AutomationProperties.Name="{loc:Str AuthLevelLabel}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str NlaToggle}"
                                         IsOn="{Binding UseNetworkLevelAuth, Mode=TwoWay}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Header="{loc:Str RestrictedAdminLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RestrictedAdmin, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str RemoteGuardLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RemoteGuard, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str PromptCredentialsLabel}"
                                         IsOn="{Binding PromptForCredentials, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Display Tab -->
            <TabItem Header="{loc:Str Display}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str ScreenWidth}" Margin="0,0,0,4" />
                        <ui:NumberBox x:Name="ScreenWidthBox" Minimum="640" Maximum="7680"
                                      AutomationProperties.Name="{loc:Str ScreenWidth}"
                                      Value="{Binding ScreenWidth, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Compact" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str ScreenHeight}" Margin="0,0,0,4" />
                        <ui:NumberBox x:Name="ScreenHeightBox" Minimum="480" Maximum="4320"
                                      AutomationProperties.Name="{loc:Str ScreenHeight}"
                                      Value="{Binding ScreenHeight, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Compact" Margin="0,0,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str FullScreen}" Margin="0,0,0,12"
                                         IsOn="{Binding FullScreen, Mode=TwoWay}" />

                        <TextBlock Text="{loc:Str ColorDepth}" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding ColorDepth}"
                                  ItemsSource="{Binding ColorDepths}"
                                  AutomationProperties.Name="{loc:Str ColorDepth}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <Separator Margin="0,4,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str UseMultimonLabel}" Margin="0,0,0,4"
                                         IsOn="{Binding UseMultimon, Mode=TwoWay}" />
                        <TextBlock Text="{loc:Str UseMultimonHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,0,0,8" />

                        <StackPanel IsEnabled="{Binding UseMultimon}">
                            <TextBlock Text="{loc:Str SelectedMonitorsLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedMonitors, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Str SelectedMonitorsLabel}"
                                     ui:ControlHelper.PlaceholderText="{loc:Str SelectedMonitorsHint}"
                                     Margin="0,0,0,12" />
                        </StackPanel>

                        <ui:ToggleSwitch Header="{loc:Str DynamicResolutionLabel}" Margin="0,0,0,12"
                                         IsOn="{Binding DynamicResolution, Mode=TwoWay}" />

                        <ui:ToggleSwitch Header="{loc:Str SmartSizingLabel}" Margin="0,0,0,12"
                                         IsOn="{Binding SmartSizing, Mode=TwoWay}" />

                        <TextBlock Text="{loc:Str ScaleFactorLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ScaleFactorOptions}"
                                  SelectedIndex="{Binding ScaleFactorIndex}"
                                  AutomationProperties.Name="{loc:Str ScaleFactorLabel}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Local Resources Tab (audio, keyboard, clipboard, printers) -->
            <TabItem Header="{loc:Str LocalResources}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str AudioPlayback}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AudioPlaybackOptions}"
                                  SelectedIndex="{Binding AudioPlaybackMode}"
                                  AutomationProperties.Name="{loc:Str AudioPlayback}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str AudioQuality}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AudioQualityOptions}"
                                  SelectedIndex="{Binding AudioQualityMode}"
                                  AutomationProperties.Name="{loc:Str AudioQuality}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str AudioCapture}" Margin="0,0,0,12"
                                         IsOn="{Binding AudioCaptureMode, Mode=TwoWay}" />

                        <TextBlock Text="{loc:Str KeyboardHookLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding KeyboardHookOptions}"
                                  SelectedIndex="{Binding KeyboardHook}"
                                  AutomationProperties.Name="{loc:Str KeyboardHookLabel}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                        <Separator Margin="0,4,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str ClipboardRedirection}"
                                         IsOn="{Binding RedirectClipboard, Mode=TwoWay}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Header="{loc:Str PrinterRedirection}"
                                         IsOn="{Binding RedirectPrinters, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Devices Tab (drives, ports, cards, cameras, USB) -->
            <TabItem Header="{loc:Str DevicesTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <ui:ToggleSwitch Header="{loc:Str DriveRedirection}"
                                         IsOn="{Binding RedirectDrives, Mode=TwoWay}" Margin="0,0,0,4" />
                        <StackPanel IsEnabled="{Binding RedirectDrives}" Margin="0,0,0,12">
                            <TextBox Text="{Binding DrivesToRedirect, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Str DriveRedirection}"
                                     ui:ControlHelper.PlaceholderText="{loc:Str DrivesToRedirectHint}" />
                        </StackPanel>

                        <ui:ToggleSwitch Header="{loc:Str ComPortsLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RedirectComPorts, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str SmartCardsLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RedirectSmartCards, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str WebAuthnLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RedirectWebAuthn, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str LocationLabel}" Margin="0,0,0,12"
                                         IsOn="{Binding RedirectLocation, Mode=TwoWay}" />

                        <TextBlock Text="{loc:Str CamerasLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CamerasToRedirect, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str CamerasLabel}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str DeviceListHint}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str PnpDevicesLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PnpDevicesToRedirect, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str PnpDevicesLabel}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str DeviceListHint}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str UsbDevicesLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding UsbDevicesToRedirect, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str UsbDevicesLabel}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str DeviceListHint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Experience Tab (visual quality) -->
            <TabItem Header="{loc:Str Experience}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <ui:ToggleSwitch Header="{loc:Str NetworkAutoDetectLabel}" Margin="0,0,0,4"
                                         IsOn="{Binding NetworkAutoDetect, Mode=TwoWay}" />
                        <TextBlock Text="{loc:Str ExperienceHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,0,0,12" />

                        <StackPanel IsEnabled="{Binding NetworkAutoDetect, Converter={StaticResource InverseBool}}">
                            <TextBlock Text="{loc:Str ConnectionTypeLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ConnectionTypeOptions}"
                                      SelectedIndex="{Binding ConnectionTypeIndex}"
                                      AutomationProperties.Name="{loc:Str ConnectionTypeLabel}"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                            <ui:ToggleSwitch Header="{loc:Str DisableWallpaperLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding DisableWallpaper, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str DisableFullWindowDragLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding DisableFullWindowDrag, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str DisableMenuAnimsLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding DisableMenuAnims, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str DisableThemesLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding DisableThemes, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str AllowFontSmoothingLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding AllowFontSmoothing, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str AllowDesktopCompositionLabel}" Margin="0,0,0,8"
                                             IsOn="{Binding AllowDesktopComposition, Mode=TwoWay}" />
                            <ui:ToggleSwitch Header="{loc:Str VideoPlaybackLabel}"
                                             IsOn="{Binding VideoPlaybackMode, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Session Tab (session behavior + performance) -->
            <TabItem Header="{loc:Str SessionSection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <ui:ToggleSwitch Header="{loc:Str AdminSessionLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding AdministrativeSession, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str AutoReconnectLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding AutoReconnect, Mode=TwoWay}" />
                        <StackPanel IsEnabled="{Binding AutoReconnect}">
                            <TextBlock Text="{loc:Str AutoReconnectRetriesLabel}" Margin="0,0,0,4" />
                            <ui:NumberBox x:Name="RetriesBox" Minimum="0" Maximum="200"
                                          AutomationProperties.Name="{loc:Str AutoReconnectRetriesLabel}"
                                          Value="{Binding AutoReconnectMaxRetries, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Compact" Margin="0,0,0,12" />
                        </StackPanel>
                        <ui:ToggleSwitch Header="{loc:Str ConnectionBarLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding DisplayConnectionBar, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str PinConnectionBarLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding PinConnectionBar, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str PublicModeLabel}" Margin="0,0,0,12"
                                         IsOn="{Binding PublicMode, Mode=TwoWay}" />

                        <Separator Margin="0,4,0,12" />
                        <TextBlock Text="{loc:Str PerformanceSection}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ui:ToggleSwitch Header="{loc:Str BandwidthAutoDetectLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding BandwidthAutoDetect, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str CompressionLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding Compression, Mode=TwoWay}" />
                        <ui:ToggleSwitch Header="{loc:Str BitmapCacheLabel}"
                                         IsOn="{Binding BitmapCachePersist, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Gateway Tab -->
            <TabItem Header="{loc:Str Gateway}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str GatewayHostnameLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding GatewayHostname, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str GatewayHostnameLabel}"
                                 ui:ControlHelper.PlaceholderText="{loc:Str GatewayHostnamePlaceholder}"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Str GatewayHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,0,0,12" />

                        <StackPanel IsEnabled="{Binding GatewayHostname, Converter={StaticResource NotEmpty}}">
                            <TextBlock Text="{loc:Str GatewayUsageLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GatewayUsageOptions}"
                                      SelectedIndex="{Binding GatewayUsageIndex}"
                                      AutomationProperties.Name="{loc:Str GatewayUsageLabel}"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                            <TextBlock Text="{loc:Str GatewayCredSourceLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding GatewayCredSourceOptions}"
                                      SelectedIndex="{Binding GatewayCredSourceIndex}"
                                      AutomationProperties.Name="{loc:Str GatewayCredSourceLabel}"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12" />

                            <ui:ToggleSwitch Header="{loc:Str GatewayPromptOnceLabel}" Margin="0,0,0,12"
                                             IsOn="{Binding GatewayPromptCredentialOnce, Mode=TwoWay}" />
                        </StackPanel>

                        <Separator Margin="0,4,0,12" />

                        <ui:ToggleSwitch Header="{loc:Str AadAuthLabel}" Margin="0,0,0,12"
                                         IsOn="{Binding EnableRdsAadAuth, Mode=TwoWay}" />

                        <TextBlock Text="{loc:Str KdcProxyLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding KdcProxyName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str KdcProxyLabel}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str LoadBalanceLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding LoadBalanceInfo, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str LoadBalanceLabel}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{loc:Str PcbLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Pcb, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str PcbLabel}"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Str PcbHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced Tab (RemoteApp + raw .rdp settings) -->
            <TabItem Header="{loc:Str Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel Margin="4" MaxWidth="640">
                        <TextBlock Text="{loc:Str RemoteAppSection}" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <ui:ToggleSwitch Header="{loc:Str RemoteAppModeLabel}" Margin="0,0,0,8"
                                         IsOn="{Binding RemoteAppMode, Mode=TwoWay}" />
                        <StackPanel IsEnabled="{Binding RemoteAppMode}">
                            <TextBlock Text="{loc:Str RemoteAppProgramLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RemoteAppProgram, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Str RemoteAppProgramLabel}"
                                     ui:ControlHelper.PlaceholderText="{loc:Str RemoteAppProgramPlaceholder}"
                                     Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Str RemoteAppNameLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RemoteAppName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Str RemoteAppNameLabel}"
                                     Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Str RemoteAppCmdLineLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RemoteAppCmdLine, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Str RemoteAppCmdLineLabel}"
                                     Margin="0,0,0,12" />
                        </StackPanel>

                        <Separator Margin="0,4,0,12" />
                        <TextBlock Text="{loc:Str ExtraSettingsLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Str ExtraSettingsHint}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding ExtraSettings, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Str ExtraSettingsLabel}"
                                 AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                                 FontFamily="Consolas"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Buttons: constrained to the same box as the centered content column so their
             right edge lines up exactly with the fields above. -->
        <Grid Grid.Row="1" MaxWidth="656">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,8,0">
                <Button Content="{loc:Str TestConnection}" Command="{Binding TestConnectionCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{loc:Str Save}" Command="{Binding SaveCommand}"
                        IsDefault="True"
                        Style="{StaticResource RnAccentButtonStyle}" Margin="0,0,8,0" />
                <Button Content="{loc:Str Cancel}" Command="{Binding CancelCommand}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
