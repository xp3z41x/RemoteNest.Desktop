<Window x:Class="RemoteNest.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:RemoteNest.Localization"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="/Assets/app.ico"
        Title="{loc:Str SettingsTitle}"
        Width="500" MinWidth="380" MinHeight="420" MaxHeight="990"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=LanguageComboBox}"
        Loaded="Window_Loaded">

    <!-- Escape closes via the Close button's IsCancel — no extra KeyBinding needed. -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <!-- Symmetric margins: the scrollbar only exists as a small-display fallback,
                 so no permanent right gutter is reserved for it. -->
            <StackPanel>
                <!-- Language -->
                <TextBlock Text="{loc:Str Language}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="LanguageComboBox" MinHeight="34" Padding="12,7"
                          AutomationProperties.Name="{loc:Str Language}"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{loc:Str LanguageDescription}" FontSize="12"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />

                <!-- Theme -->
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="{loc:Str Theme}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="ThemeComboBox" MinHeight="34" Padding="12,7"
                              AutomationProperties.Name="{loc:Str Theme}"
                              SelectionChanged="ThemeComboBox_SelectionChanged"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="{loc:Str ThemeDescription}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Transparency (acrylic) -->
                <StackPanel Margin="0,24,0,0">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="{loc:Str Transparency}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TransparencyValueText" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                    <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100"
                            AutomationProperties.Name="{loc:Str Transparency}"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="TransparencySlider_ValueChanged" />
                    <TextBlock Text="{loc:Str TransparencyDescription}" FontSize="12"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Start with Windows -->
                <StackPanel Margin="0,24,0,0">
                    <ui:ToggleSwitch x:Name="AutoStartToggle"
                                     Header="{loc:Str AutoStartWithWindows}"
                                     Toggled="AutoStartToggle_Toggled" />
                    <TextBlock Text="{loc:Str AutoStartDescription}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Windows RDP security warnings -->
                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="{loc:Str RdpWarningsSection}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource RnCardBrush}"
                            CornerRadius="6" Padding="14">
                        <StackPanel>
                            <ui:ToggleSwitch x:Name="RdpWarningsToggle"
                                             Header="{loc:Str RdpWarningsToggle}"
                                             Toggled="RdpWarningsToggle_Toggled" />
                            <TextBlock Text="{loc:Str RdpWarningsDescription}" FontSize="12"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock Text="{loc:Str RdpWarningsSecurityNote}" FontSize="12"
                                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock x:Name="RdpWarningsStatusText" FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Str Close}" Click="CloseButton_Click"
                    IsDefault="True" IsCancel="True"
                    Style="{StaticResource RnAccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
