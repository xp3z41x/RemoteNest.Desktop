<Window x:Class="RemoteNest.Views.ShadowSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:loc="clr-namespace:RemoteNest.Localization"
        ui:WindowHelper.UseModernWindowStyle="True"
        Icon="/Assets/app.ico"
        Title="{loc:Str ShadowSessionTitle}"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=SessionIdBox}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Str ShadowSessionIdLabel}" Margin="0,0,0,4" />
            <ui:NumberBox x:Name="SessionIdBox" Minimum="0" Maximum="65535" Value="1"
                          AutomationProperties.Name="{loc:Str ShadowSessionIdLabel}"
                          SpinButtonPlacementMode="Compact" Margin="0,0,0,4" />
            <TextBlock Text="{loc:Str ShadowSessionIdHint}" FontSize="11" FontFamily="Consolas"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,12" />

            <ui:ToggleSwitch x:Name="ControlToggle" Header="{loc:Str ShadowControlLabel}"
                             IsOn="True" Margin="0,0,0,8" />
            <ui:ToggleSwitch x:Name="NoConsentToggle" Header="{loc:Str ShadowNoConsentLabel}"
                             Margin="0,0,0,4" />
            <TextBlock Text="{loc:Str ShadowHint}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,0,0,12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Str ShadowStart}" Click="StartButton_Click"
                    IsDefault="True"
                    Style="{StaticResource RnAccentButtonStyle}" Margin="0,0,8,0" />
            <Button Content="{loc:Str Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
